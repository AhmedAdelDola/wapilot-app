# Message Pro App Configuration

# Chatwoot Server Configuration
EXPO_PUBLIC_CHATWOOT_BASE_URL=https://omni.message-pro.com
EXPO_PUBLIC_CHATWOOT_WEBSOCKET_URL=wss://omni.message-pro.com

# App Configuration
EXPO_PUBLIC_APP_NAME=Message Pro
EXPO_PUBLIC_APP_SLUG=message-pro

# Minimum Chatwoot Version Required
EXPO_PUBLIC_MINIMUM_CHATWOOT_VERSION=4.1.0

# Sentry (Optional - for error tracking)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_PROJECT_NAME=
EXPO_PUBLIC_SENTRY_ORG_NAME=

# Expo Project ID (for EAS Build)
EXPO_PUBLIC_PROJECT_ID=

# Firebase (for Push Notifications)
# google-services.json and GoogleService-Info.plist are in project root
# Config plugins in app.config.ts reference them directly

# Apple Configuration (iOS only)
EXPO_APPLE_ID=
EXPO_APPLE_TEAM_ID=

# Storybook (Development only)
EXPO_STORYBOOK_ENABLED=false

# Google Sign-In
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=547711081497-r275qot546as6q3b86km8p594mfejhmg.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=547711081497-r275qot546as6q3b86km8p594mfejhmg.apps.googleusercontent.com
